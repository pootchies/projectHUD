// maps the most recent pulse period to an variable window size. period >= 50 ms -> 1 sample, period <= 10 ms -> 10 samples, linear in between
static uint8_t getWindowFromPeriod(uint32_t period) {
	if (period >= UPPER_PERIOD) return 1;
	if (period <= LOWER_PERIOD) return MOVING_AVG_ELEMENTS;
	// linear interpolation, maps period to a number from 1 to 10 based on its value compared to upper and lower period
	return (uint8_t)((((UPPER_PERIOD - period) * (MOVING_AVG_ELEMENTS - 1)) / (UPPER_PERIOD - LOWER_PERIOD)) + 1);
}

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim) {
	if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1) {
		// read current timer value (triggered on a GPIO edge)
		uint32_t tachCaptureValue = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);
		uint32_t delta = tachCaptureValue - prevTachCaptureValue;
		// clamp first pulse after idling for a while
		if (delta > PERIOD_TIMEOUT) delta = PERIOD_TIMEOUT;
		// circular buffer, replaces oldest period with most recent
		tachPeriods[tachIdx] = delta;
		// increment tachIdx, wrap back to 0 if it reaches 10
		tachIdx = (tachIdx + 1) % MOVING_AVG_ELEMENTS;
		// refresh value
		prevTachCaptureValue = tachCaptureValue;
		HAL_GPIO_TogglePin(GPIOC, YELLOW_LED_Pin); // blinky
	}
	if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2) {
		// read current timer value (triggered on a GPIO edge)
		uint32_t speedCaptureValue = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
		uint32_t delta = speedCaptureValue - prevSpeedCaptureValue;
		// clamp first pulse after idling for a while
		if (delta > PERIOD_TIMEOUT) delta = PERIOD_TIMEOUT;
		speedPeriods[speedIdx] = delta;
		// increment speedIdx, wrap back to 0 if it reaches 10
		speedIdx = (speedIdx + 1) % MOVING_AVG_ELEMENTS;
		// refresh value
		prevSpeedCaptureValue = speedCaptureValue;
		HAL_GPIO_TogglePin(GPIOC, GREEN_LED_Pin); // blinky
	}
}
