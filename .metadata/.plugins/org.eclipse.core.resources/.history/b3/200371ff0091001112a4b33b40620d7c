/**
  * @brief  Function implementing the inputTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartInputTask */
void StartInputTask(void *argument)
{
  /* USER CODE BEGIN 5 */
	const uint8_t PULSE_PER_REV = 2; // tachometer pulses per crankshaft revolution
	const float PULSE_PER_KILO = 2482.215342; // calculated from 72158 pulses / 29.07 km

	uint32_t tachOutput = 0;
	uint32_t speedOutput = 0;
	uint32_t tachTimeoutDebounce = 0;
	uint32_t speedTimeoutDebounce = 0;

  /* Infinite loop */
  for(;;)
{
	uint32_t frame = 0; // stores this loop's frame data
	uint32_t tachAverage = 0;
	uint32_t speedAverage = 0;
	uint8_t isDark = 0; // headlights on/off flag
	uint8_t isTachZero = 0;
	uint8_t isSpeedZero = 0;

	// save a local copy of the volatile indices from the ISR (in case it changes mid loop)
	uint8_t tachIdxTemp = tachIdx;
	uint8_t speedIdxTemp = speedIdx;
	// get the latest period reading from the ISR, it's one element behind the current index. modulo to reset back to 0 if >9
	uint32_t tachLatestPeriod = tachPeriods[(tachIdxTemp + MOVING_AVG_ELEMENTS - 1) % MOVING_AVG_ELEMENTS];
	uint32_t speedLatestPeriod = speedPeriods[(speedIdxTemp + MOVING_AVG_ELEMENTS - 1) % MOVING_AVG_ELEMENTS];
	// get window size based on most recent period
	uint8_t tachWindowSize = getWindowFromPeriod(tachLatestPeriod);
	uint8_t speedWindowSize = getWindowFromPeriod(speedLatestPeriod);

	// average only the most recent x samples, averaging backwards in the array from the current temp index
	for (uint8_t windowIncrement = 0; windowIncrement < tachWindowSize; windowIncrement++) {
		// get period of each element of tachPeriods[] array and sum into average, starting at temp index and working backwards
		// index sweeps between 0 and 18, modulo loops it to 0 and 9
		uint32_t currentPeriod = tachPeriods[(tachIdxTemp + MOVING_AVG_ELEMENTS - 1 - windowIncrement) % MOVING_AVG_ELEMENTS];
		tachAverage += currentPeriod;
	}
	for (uint8_t windowIncrement = 0; windowIncrement < speedWindowSize; windowIncrement++) {
		// get period of each element of speedPeriods[] array and sum into average, starting at temp index and working backwards
		// index sweeps between 0 and 18, modulo loops it to 0 and 9
		uint32_t currentPeriod = speedPeriods[(speedIdxTemp + MOVING_AVG_ELEMENTS - 1 - windowIncrement) % MOVING_AVG_ELEMENTS];
		speedAverage += currentPeriod;
	}
	// average sums over the active window
	tachAverage /= tachWindowSize;
	speedAverage /= speedWindowSize;

	// set output to zero at low enough speeds
	// get current timer value
	uint32_t currentTime = __HAL_TIM_GET_COUNTER(&htim2);
	// if period is large enough, set display to output zero
	if ((currentTime - prevTachCaptureValue) > (PERIOD_TIMEOUT - tachTimeoutDebounce)) {
		isTachZero = 1;
		// include a debounce so the value doesn't jump between 0 and a number when the period is right on the threshold
		tachTimeoutDebounce = PERIOD_DEBOUNCE;
		// load entire array with a PERIOD_TIMEOUT; means when restarting at a low speed, the value doesn't jump up randomly before settling
		for (uint8_t i = 0; i < MOVING_AVG_ELEMENTS; i++) tachPeriods[i] = PERIOD_TIMEOUT;
	} else { // otherwise resume normal operation
		isTachZero = 0;
		tachTimeoutDebounce = 0;
	}
	// if period is large enough, set display to output zero
	if ((currentTime - prevSpeedCaptureValue) > (PERIOD_TIMEOUT - speedTimeoutDebounce)) {
		isSpeedZero = 1;
		// include a debounce so the value doesn't jump between 0 and a number when the period is right on the threshold
		speedTimeoutDebounce = PERIOD_DEBOUNCE;
		// load entire array with a PERIOD_TIMEOUT; means when restarting at a low speed, the value doesn't jump up randomly before settling
		for (uint8_t i = 0; i < MOVING_AVG_ELEMENTS; i++) speedPeriods[i] = PERIOD_TIMEOUT;
	} else { // otherwise resume normal operation
		isSpeedZero = 0;
		speedTimeoutDebounce = 0;
	}

	// protect against divide by zero
	if (tachAverage == 0) tachAverage = 1;
	if (speedAverage == 0) speedAverage = 1;

	// tach calculation: (µs/min) / (µs/pulse × pulse/rotation) = rotations/min
	uint32_t tachRaw = ((SEC_PER_MIN * MICROS_PER_SEC) / (tachAverage * PULSE_PER_REV));
	// speed calculation: (µs/hour) / (µs/pulse × pulses/km) = km/h
	float speedRaw = (float)(SEC_PER_HOUR * MICROS_PER_SEC) / ((float)speedAverage * PULSE_PER_KILO);

	// if flagged as zero or if average is more than max period, set output to 0
	if (isTachZero || (tachAverage > TACH_MAX_PERIOD)) {
		tachOutput = 0;
	} else if (tachRaw < 6500) { // if normal operating condition:
		// display hysteresis: displayed value only re-rounds once raw value exits TACH_HYST threshold
		uint32_t tachDiff = labs((int32_t)tachRaw - (int32_t)tachOutput);
		if (tachDiff >= TACH_HYST) {
			tachOutput = ((tachRaw + 50) / 100) * 100; // round to nearest hundred; +50 ensures nearest hundred rather than floor
		}
	} else { // clamp at max value if beyond it
		tachOutput = 6500;
	}
	// if flagged as zero or if average is more than max period, set output to 0
	if (isSpeedZero || (speedAverage > SPEED_MAX_PERIOD)) {
		speedOutput = 0;
	} else if (speedRaw < 200.0f) {
		// display hysteresis: displayed value only re-rounds once raw value exits SPEED_HYST threshold
		float speedDiff = fabsf(speedRaw - (float)speedOutput);
		if (speedDiff >= SPEED_HYST) {
			speedOutput = (uint32_t)(speedRaw + 0.5f); // +0.5f ensures nearest ones digit rather than floor
		}
	} else { // clamp at max value if beyond it
		speedOutput = 200;
	}

	// headlight input is low when headlights are on -> dim LEDs by triggering isDark flag
	isDark = (HAL_GPIO_ReadPin(LIGHT_GPIO_Port, LIGHT_Pin) == GPIO_PIN_RESET);

	// assemble frame
	frame = FRAME_PACK(speedOutput, (tachOutput / 100), isDark);
	// set frame to 0 if displayQueue is full
	osMessageQueuePut(displayQueueHandle, &frame, 0, 0);
    osDelay(50); // 20 Hz
  }
  /* USER CODE END 5 */
}

/* USER CODE BEGIN Header_StartDisplayTask */
/**
* @brief Function implementing the displayTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartDisplayTask */
void StartDisplayTask(void *argument)
{
  /* USER CODE BEGIN StartDisplayTask */
	uint32_t frame = 0;
	uint16_t speed = 0;
	uint16_t rpm = 0;
	uint8_t segState[TLC_CHANNELS] = {0}; // array containing on/off state of every TLC output
	uint8_t digits[NUM_DIGITS] = {0}; // array containing value 0 to 9 of each digit
	uint8_t tlcBuffer[TLC_BYTES] = {0};

  /* Infinite loop */
  for(;;)
  {
	// wait for new frame update from inputTask. once arrived, load into frame variable and continue
	if (osMessageQueueGet(displayQueueHandle, &frame, NULL, osWaitForever) != osOK) {
		continue;
	}
	// extract speed and rpm from latest frame
	speed = FRAME_SPEED(frame);
	rpm = FRAME_RPM(frame);
	// extract isDark flag from frame. output PWM to timer ch.4 which is connected to BLANK. if isDark flag is true, output PWM_DARK, and vice versa
	__HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, (FRAME_DARK(frame) ? PWM_DARK : PWM_BRIGHT));

	// process each number for each digit with leading zero blanking
	digits[0] = (speed >= 100) ? (speed / 100) : BLANK_DIGIT;
	digits[1] = (speed >= 10) ? ((speed / 10) % 10) : BLANK_DIGIT;
	digits[2] = speed % 10;
	digits[3] = rpm / 10;   // no blanked leading zero for tach
	digits[4] = rpm % 10;

	// select table to use based on DISPLAY_ORIENTATION
	const uint8_t *segTable = (DISPLAY_ORIENTATION == 0) ? SEG_NORMAL : SEG_FLIPPED;

	for (int8_t digitIndex = 0; digitIndex < NUM_DIGITS; digitIndex++) {
		// digits[digitIndex] gets current number loaded in that digit
		uint8_t segments = segTable[digits[digitIndex]];
		for (int8_t segIndex = 0; segIndex < NUM_SEGMENTS; segIndex++) {
			segState[DIGIT_BASE[digitIndex] + segIndex] = (segments >> segIndex) & 1;
		}
	}
	// always on decimal point for last display for tach (eg. 3.5 instead of 35 * 100 RPM)
	segState[DIGIT_BASE[NUM_DIGITS - 1] + NUM_SEGMENTS] = 1;

	// tlc5947 takes 12 bits per channel, with the 12-bit value indicating its brightness
	// since global PWM dimming is used, segments are either full-on or full-off (0xFFF or 0x000)
	// display data is uint8_t, so an 8-bit input needs to be converted to a 12-bit output
	// if seg1 is on and seg2 is off: (0xFFF + 0x000) which is split into (FF F0 00) and merged into -> 0xFFF000
	// iterate in pairs
	for (int8_t currentPair = 0; currentPair < TLC_CHANNELS; currentPair += 2) {
		uint8_t firstChannel = segState[TLC_CHANNELS - currentPair - 1]; // first channel of the pair, upper 12 bits
		uint8_t secondChannel = segState[TLC_CHANNELS - currentPair - 2]; // second channel of the pair, lower 12 bits
		// get first byte position in tlcBuffer, if segState is high for that bit, set the next 8 bits to FF, otherwise, set to 0
		tlcBuffer[(currentPair / 2) * 3] = firstChannel ? 0xFF : 0x00;
		// get second byte position. if segState of first channel is 1, set bottom half of buffer to 0xF0, and vice versa
		// do the same for the second channel on the top half
		tlcBuffer[(currentPair / 2) * 3 + 1] = (firstChannel ? 0xF0 : 0x00) | (secondChannel ? 0x0F : 0x00);
		// get third byte position, do same as previous steps for second channel
		tlcBuffer[(currentPair / 2) * 3 + 2] = secondChannel ? 0xFF : 0x00;
	}

	// shift out frame to tlc5947 driver via SPI
	HAL_SPI_Transmit(&hspi2, tlcBuffer, TLC_BYTES, HAL_MAX_DELAY);
	// toggle latch to load message frame into display drivers
	HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_RESET);

//    osDelay(1); // no need for osDelay as message is already blocked
  }
  /* USER CODE END StartDisplayTask */
}

